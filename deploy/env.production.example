# Aster production env — copy to /home/ubuntu/aster/.env.local on the VM.
#
#   cp deploy/env.production.example .env.local && nano .env.local
#   chmod 600 .env.local
#
# This filename is not negotiable: package.json's db:migrate script hardcodes
# `node --env-file=.env.local`, and Next loads .env.local at runtime too.
# NEVER commit this file — .gitignore already covers .env*.

# --- Postgres (local to the VM) ---------------------------------------------
# lib/server/db.ts has no SSL and no DATABASE_URL support, so Postgres must be
# on 127.0.0.1. A managed host (Neon/Supabase) will NOT work without a code
# change to add `ssl: { rejectUnauthorized: false }` to the pool.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=Personal_assistant_db
POSTGRES_USER=aster
POSTGRES_PASSWORD=          # printed by setup-vm.sh, also in ~/.aster-db-password

# --- Auth --------------------------------------------------------------------
# Signs email-verification and password-reset OTPs. Generate a fresh one:
#   openssl rand -base64 48
# Do not reuse the development value.
PHONE_AUTH_SECRET=

# Gmail connect — Google Cloud OAuth client with the Gmail scopes. Redirect URI:
#   https://aster.prathamshah.me/api/integrations/gmail/callback
# These are sensitive scopes: until Google verifies the client, its consent
# screen only admits the 100 test users listed on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google sign-in — a SEPARATE Google Cloud project/OAuth client whose consent
# screen declares no sensitive scopes (sign-in only asks for openid, email,
# profile), so it has no 100-user cap. Redirect URI:
#   https://aster.prathamshah.me/api/auth/google/callback
# If left blank, sign-in falls back to the GOOGLE_CLIENT_* pair above and
# inherits the Gmail client's 100-user cap.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# GitHub OAuth app — Authorization callback URL:
#   https://aster.prathamshah.me/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mailer ------------------------------------------------------------------
# Gmail App Password (16 chars, requires 2FA on the account) — not the login
# password. https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# --- AI ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Only set for a non-OpenAI, OpenAI-compatible endpoint.
# Defaults to https://api.openai.com/v1 (lib/server/brief-ai.ts).
# OPENAI_BASE_URL=

# --- Briefings ---------------------------------------------------------------
# Shared secret for the Trigger.dev -> app calls. Sent as the `x-internal-secret`
# header to /api/briefings/claim-due and /api/briefings/run. Generate with:
#   openssl rand -hex 32
# The SAME value must be set in the Trigger.dev dashboard.
# If this is unset those routes return 503 not_configured — a handy smoke test.
INTERNAL_API_SECRET=

# --- Not set here ------------------------------------------------------------
# APP_BASE_URL is read only by the Trigger.dev tasks (trigger/*.ts), which run
# on Trigger.dev's cloud, not on this VM. Set it in the Trigger.dev dashboard:
#   APP_BASE_URL=https://aster.prathamshah.me
#
# NODE_ENV is set by PM2 (deploy/ecosystem.config.cjs), not here.
